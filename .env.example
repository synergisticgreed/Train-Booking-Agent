# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=20
MOCK_LLM=false

DB_PATH=data/ujjwal.db
DOCS_DIR=data/docs

# st = multilingual sentence-transformers (downloads once); hash = offline char-trigram embedder
EMBEDDER=st
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_MIN_COS=0.5
